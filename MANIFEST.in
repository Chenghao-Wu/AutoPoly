# Bundled external resources required at runtime:
#  - extern/moltemplate: moltemplate scripts, .lt force-field files, .prm files
#  - extern/rdlt_data:   .fdefn SMARTS files, atom-type dicts (.pkl)
recursive-include AutoPoly/extern *

# Docs / metadata in the sdist
include README.md license.md CHANGELOG.md

# Never ship bytecode or test artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
