set type @atom:155  charge      0.418 # H  - HO   | all-atom H(O): mono alcohols
set type @atom:157  charge      0.145 # C  - CT   | all-atom C: CH3 & CH2, prim. alcohols
set type @atom:180  charge     -0.400 # O  - OS   | O: dialkyl ether OPLS/2020
set type @atom:182  charge      0.140 # C  - CT   | C(H2OR): ethyl ether
set type @atom:185  charge      0.030 # H  - HC   | H(COR): alpha H ether OPLS/2020 see 794
} # End of charges

