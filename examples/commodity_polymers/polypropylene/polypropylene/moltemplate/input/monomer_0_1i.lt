import "oplsaa.lt"    # <-- defines the OPLS-AA force field
monomer_0_1i inherits OPLSAA {

# atom-id  mol-id  atom-type charge      X         Y        Z

  write("Data Atoms") {
	$atom:C1 $mol:... @atom:81 -0.1200    -0.744   0.000   0.000
	$atom:C2 $mol:... @atom:82 -0.0600    0.744   0.000   0.000
	$atom:C3 $mol:... @atom:80 -0.1800    1.388   -0.407   1.276
	$atom:H4 $mol:... @atom:85 0.0600    -1.060   0.515   -0.950
	$atom:H5 $mol:... @atom:85 0.0600    -1.211   -0.999   -0.060
	$atom:H6 $mol:... @atom:85 0.0600    1.159   -0.506   -0.869
	$atom:H7 $mol:... @atom:85 0.0600    2.476   -0.514   1.067
	$atom:H8 $mol:... @atom:85 0.0600    1.332   0.343   2.075
	$atom:H9 $mol:... @atom:85 0.0600    1.075   -1.413   1.652
  }

  write('Data Bond List') {
	$bond:C1C2	$atom:C1	$atom:C2
	$bond:C2C3	$atom:C2	$atom:C3
	$bond:C1H4	$atom:C1	$atom:H4
	$bond:C1H5	$atom:C1	$atom:H5
	$bond:C2H6	$atom:C2	$atom:H6
	$bond:C3H7	$atom:C3	$atom:H7
	$bond:C3H8	$atom:C3	$atom:H8
	$bond:C3H9	$atom:C3	$atom:H9
  }
}  # monomer_0_1i

