    dihedral_coeff @dihedral:410-81-408-406 opls 0.0 0.0 0.198 0.0
    dihedral_coeff @dihedral:410-431-408-406 opls 0.0 0.0 0.198 0.0
    dihedral_coeff @dihedral:410-432-408-406 opls 0.0 0.0 0.198 0.0
  } #(end of dihedral_coeffs)

  write_once("In Init") {
    units real
    atom_style full
    bond_style hybrid harmonic
    angle_style hybrid harmonic
    dihedral_style hybrid opls
    improper_style hybrid harmonic
    pair_style hybrid lj/cut/coul/long 10.0 10.0
    pair_modify mix geometric
    special_bonds lj/coul 0.0 0.0 0.5
    kspace_style pppm 0.0001
  } #end of init parameters

} # OPLSAA
