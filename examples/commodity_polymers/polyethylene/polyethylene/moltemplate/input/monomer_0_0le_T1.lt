import "oplsaa.lt"    # <-- defines the OPLS-AA force field
monomer_0_0le_T1 inherits OPLSAA {

# atom-id  mol-id  atom-type charge      X         Y        Z

  write("Data Atoms") {
	$atom:C1 $mol:... @atom:80 -0.1800    -0.752   -0.000   -0.000
	$atom:C2 $mol:... @atom:81 -0.1200    0.752   -0.000   -0.000
	$atom:H3 $mol:... @atom:85 0.0600    -1.103   0.470   0.954
	$atom:H4 $mol:... @atom:85 0.0600    -1.133   0.634   -0.836
	$atom:H5 $mol:... @atom:85 0.0600    -1.172   -1.023   -0.096
	$atom:H6 $mol:... @atom:85 0.0600    1.118   0.978   -0.354
	$atom:H7 $mol:... @atom:85 0.0600    1.201   -0.849   -0.533
  }

  write('Data Bond List') {
	$bond:C1C2	$atom:C1	$atom:C2
	$bond:C1H3	$atom:C1	$atom:H3
	$bond:C1H4	$atom:C1	$atom:H4
	$bond:C1H5	$atom:C1	$atom:H5
	$bond:C2H6	$atom:C2	$atom:H6
	$bond:C2H7	$atom:C2	$atom:H7
  }
}  # monomer_0_0le_T1

# Note: You don't need to supply the partial partial charges of the atoms.
#       If you like, just fill the fourth column with zeros ("0.000").
#       Moltemplate and LAMMPS will automatically assign the charge later

