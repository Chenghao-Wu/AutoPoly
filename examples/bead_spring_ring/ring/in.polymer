# LAMMPS input script for bead-spring polymer

units           lj
atom_style      molecular
boundary        p p p

read_data       polymer.data

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0000 1.0000
pair_coeff      1 2 1.0000 1.0000
pair_coeff      2 2 1.0000 1.0000

bond_style      harmonic
bond_coeff      1 30.0 1.0000

angle_style     harmonic
angle_coeff     1 20.0000 180.0  # A-A-A
angle_coeff     2 15.0000 180.0  # A-A-B
angle_coeff     3 10.0000 180.0  # A-B-B
angle_coeff     4 10.0000 180.0  # B-B-B

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

minimize        1.0e-4 1.0e-6 1000 10000
reset_timestep  0

timestep        0.005
fix             1 all nvt temp 1.0 1.0 0.5
dump            1 all custom 1000 dump.lammpstrj id type x y z
thermo          1000
run             100000
