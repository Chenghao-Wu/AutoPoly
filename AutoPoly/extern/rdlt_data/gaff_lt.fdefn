# ==============================================================================
# Ring-Variant Atom Types (Specific SMARTS for 3- and 4-membered rings)
# ==============================================================================
# These types are ring-variant and ONLY apply to atoms actually IN small rings.
# The [r3] and [r4] constraints ensure these patterns don't match regular atoms.
# Higher family numbers give these specific patterns priority over generic ones.

# ni: amide N in 3-membered rings (n in aziridine amides)
# Must be: sp3 N in 3-membered ring, connected to C=O (amide)
DefineFeature @atom:ni [$([NX3;r3][CX3]=[OX1])]
Family 121ni
EndFeature

# nj: amide N in 4-membered rings (n in azetidine amides)
# Must be: sp3 N in 4-membered ring, connected to C=O (amide)
DefineFeature @atom:nj [$([NX3;r4][CX3]=[OX1])]
Family 122nj
EndFeature

# nk: ammonium N in 3-membered rings (n4 in aziridinonium)
# Must be: sp3 N+ in 3-membered ring
DefineFeature @atom:nk [$([NX4+;r3])]
Family 123nk
EndFeature

# nl: ammonium N in 4-membered rings (n4 in azetidinium)
# Must be: sp3 N+ in 4-membered ring
DefineFeature @atom:nl [$([NX4+;r4])]
Family 124nl
EndFeature

# nm: amine N connected to aromatic in 3-membered rings (nh in aziridine-aniline)
# Must be: sp3 N in 3-membered ring, connected to aromatic carbon
DefineFeature @atom:nm [$([NX3;r3][c])]
Family 125nm
EndFeature

# nn: amine N connected to aromatic in 4-membered rings (nh in azetidine-aniline)
# Must be: sp3 N in 4-membered ring, connected to aromatic carbon
DefineFeature @atom:nn [$([NX3;r4][c])]
Family 126nn
EndFeature

# np: sp3 amine N in 3-membered rings (n3 in aziridine)
# Must be: sp3 N in 3-membered ring, NOT amide, NOT connected to aromatic
DefineFeature @atom:np [$([NX3;r3;!$([NX3][CX3]=[OX1]);!$([NX3][c])])]
Family 127np
EndFeature

# nq: sp3 amine N in 4-membered rings (n3 in azetidine)
# Must be: sp3 N in 4-membered ring, NOT amide, NOT connected to aromatic
DefineFeature @atom:nq [$([NX3;r4;!$([NX3][CX3]=[OX1]);!$([NX3][c])])]
Family 128nq
EndFeature

# op: ether oxygen in 3-membered rings (os in epoxides/oxiranes)
# Must be: sp3 O in 3-membered ring with 2 carbons
DefineFeature @atom:op [$([OX2;r3]([#6])[#6])]
Family 129op
EndFeature

# oq: ether oxygen in 4-membered rings (os in oxetanes)
# Must be: sp3 O in 4-membered ring with 2 carbons
DefineFeature @atom:oq [$([OX2;r4]([#6])[#6])]
Family 130oq
EndFeature

# sp: thioether sulfur in 3-membered rings (ss in thiiranes)
# Must be: sp3 S in 3-membered ring with 2 carbons
DefineFeature @atom:sp [$([SX2;r3]([#6])[#6])]
Family 131sp
EndFeature

# sq: thioether sulfur in 4-membered rings (ss in thietanes)
# Must be: sp3 S in 4-membered ring with 2 carbons
DefineFeature @atom:sq [$([SX2;r4]([#6])[#6])]
Family 132sq
EndFeature
