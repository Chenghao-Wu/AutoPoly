# Only match carbons in aromatic rings that CONTAIN a heteroatom (N, O, S)
DefineFeature @atom:cd [$([c;R1]1[n,o,s][c,n,o,s][c,n,o,s][c,n,o,s]1),$(c1[n,o,s]cccc1),$(c1c[n,o,s]ccc1),$(c1cc[n,o,s]cc1)]
Family 41cd
EndFeature

