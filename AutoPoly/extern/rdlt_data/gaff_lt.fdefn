# Inner Sp2 N in conjugated systems
DefineFeature @atom:ne [$([N]=[N][N]=[N])]
Family 58ne
EndFeature

# Inner Sp2 N in conjugated (identical to ne)
DefineFeature @atom:nf [$([N]=[N][N]=[N])]
Family 59nf
EndFeature

# Phosphate with two connected atoms
DefineFeature @atom:p2 [$([PX2])]
Family 60p2
EndFeature

# Phosphate with three connected atoms (PH3)
DefineFeature @atom:p3 [$([PX3][H])]
Family 61p3
