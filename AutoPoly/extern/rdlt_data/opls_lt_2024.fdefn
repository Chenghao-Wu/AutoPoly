# =============================================================================
# PEO/PEG (polyethylene oxide/glycol) - OPLS-AA 2020 ether types
# Structure: -CH2-CH2-O-CH2-CH2-O- (ethylene oxide repeat units)
# These patterns are more general to handle the -O-C-C-O- connectivity
# =============================================================================

# Ether oxygen in PEO chain - type 180 (dialkyl ether O)
# More general: O bonded to two CH2 groups
DefineFeature @atom:180 [$([OD2]([CH2D4])[CH2D4])]
Family 100OS_PEO
EndFeature

# Ether O between C that connects to another O (PEO internal)
DefineFeature @atom:180 [$([OD2]([CD4][OD2])[CD4])]
Family 101OS_PEO2
EndFeature

# CH2 in PEO chain - type 182 (ethyl ether C)
# CH2 connected to ether O
DefineFeature @atom:182 [$([CH2D4][OD2][#6])]
Family 102CT_PEO
EndFeature

# Terminal CH3 next to ether O - type 181 (methyl ether)
DefineFeature @atom:181 [$([CH3D4][OD2][#6])]
Family 103CT_PEO_TERM
EndFeature

# H on C adjacent to ether O - type 185 (alpha H ether)
# General pattern for H on C-O
DefineFeature @atom:185 [$([#1][CD4][OD2])]
Family 104HC_PEO
EndFeature
