# ALKYL BENZENE (types 61-64, 148-149, 515-516)
# =============================================================================

# CH3-benzene (toluene)
DefineFeature @atom:61 [$([CH3][c])]
Family 7CT
EndFeature
DefineFeature @atom:148 [$([CH3][c])]
Family 8CT
EndFeature

# CH2-benzene (ethylbenzene)
