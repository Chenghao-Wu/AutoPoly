# OPLS-AA 2024 Feature Definitions for RDKit
#
# Atom types are based on OPLS-AA 2024 numbering from oplsaa.lt
# See: Jorgensen et al., J. Phys. Chem. B 2024
#
# Format:
#   DefineFeature @atom:NUM [SMARTS]
#   Family PRIORITY_CLASS
#   EndFeature
#
# Priority numbers: Higher = more specific pattern takes precedence
# Class names (CT, HC, CA, etc.) are from OPLS-AA atom classes

# =============================================================================
# ALKANES (OPLS/2020 parameters, types 54-60)
# =============================================================================

# CH3 (methyl) - types 54-56 for different branching
DefineFeature @atom:54 [$([CH3D4][C])]
Family 0CT
EndFeature
DefineFeature @atom:55 [$([CH3D4][CH1])]
Family 1CT
EndFeature
DefineFeature @atom:56 [$([CH3D4][CH0]([CH3])([CH3])[CH3])]
Family 2CT
EndFeature

# CH2 (methylene) - type 57
DefineFeature @atom:57 [$([CH2D4]([C])[C])]
Family 3CT
EndFeature

# CH (methine) - type 58
DefineFeature @atom:58 [$([CH1D4]([C])([C])[C])]
Family 4CT
EndFeature

# C (quaternary) - type 59
DefineFeature @atom:59 [$([CH0D4]([C])([C])([C])[C])]
Family 5CT
EndFeature

# CH4 (methane) - type 138 (note: 138, not 54 range)
DefineFeature @atom:138 [CH4D4]
Family 6CT
EndFeature

# H on alkane - type 60
DefineFeature @atom:60 [$([#1][CH4])]
Family 0HC
EndFeature
DefineFeature @atom:60 [$([#1][CD4;!$([C][CD2,O,N][#6]);!$([C][F,Cl,Br,I])])]
Family 1HC
EndFeature

# =============================================================================
# ALKENES (types 141-144, 150, 178)
# =============================================================================

# R2-C= (disubstituted alkene carbon)
DefineFeature @atom:141 [$([CH0D3]([#6])([#6])=[#6])]
Family 0CM
EndFeature

# RH-C= (monosubstituted alkene carbon)
DefineFeature @atom:142 [$([CH1D3]([#6])=[#6])]
Family 1CM
EndFeature

# H2-C= (terminal alkene carbon)
DefineFeature @atom:143 [$([CH2D3]=[#6])]
Family 2CM
EndFeature

# H on alkene
DefineFeature @atom:144 [$([#1][CD3])]
Family 2HC
EndFeature

# Diene =CH-CH=
DefineFeature @atom:150 [$([CH1](=C)-[CH1]=C)]
Family 3CM
EndFeature

# Diene =CR-RC=
DefineFeature @atom:178 [$([CH0](=C)-[CH0]=C)]
Family 4CM
EndFeature

# =============================================================================
# AROMATIC BENZENE (types 145-147)
# =============================================================================

# Benzene C
DefineFeature @atom:145 [$([c]([c])[c])]
Family 0CA
EndFeature

# Benzene H
DefineFeature @atom:146 [$([#1][c]([c])[c])]
Family 0HA
EndFeature

# Naphthalene fusion C
DefineFeature @atom:147 [$([c](c)(c)(c))]
Family 1CB
EndFeature

# Biphenyl C
DefineFeature @atom:519 [$([c](c)(c)-[c](c)c)]
Family 0C!
EndFeature

