Family 59O_2_ha
EndFeature

# O_1 - sp oxygen (C#O, carbon monoxide)
DefineFeature @atom:O_1 [$([OX1]#*)]
Family 60O_1
EndFeature

# O_1_ha - sp oxygen, H-acceptor
DefineFeature @atom:O_1_ha [$([OX1]#*)]
Family 61O_1_ha
EndFeature

