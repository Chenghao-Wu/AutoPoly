# DREIDING Force Field Feature Definition File
# Generated for AutoPoly rdlt.py
# Reference: Mayo et al., J. Phys. Chem. 1990, 94, 8897-8909
#
# This file contains SMARTS patterns for DREIDING atom typing.
# DREIDING uses element-based atom types with hybridization and coordination info.
#
# Naming convention:
#   Element_hybridization (e.g., C_3 for sp3 carbon, C_R for resonance/aromatic)
#   Suffixes: _hd (H-donor), _ha (H-acceptor), _b# (bonding context), _d# (coordination)
#
# NOTE: DREIDING requires user-supplied charges (AM1-BCC, Gasteiger, or RESP)

# ============================================================================
# Hydrogen Types
# ============================================================================

# H - Generic hydrogen (not H-bonding)
DefineFeature @atom:H [$([#1])]
Family 0H
EndFeature

# H_HB - Hydrogen bond hydrogen (H bonded to N, O, F)
DefineFeature @atom:H_HB [$([#1][N,O,F])]
Family 1H_HB
EndFeature

# H_B - Bridging hydrogen (in B-H-B bridges)
DefineFeature @atom:H_B [$([#1]([B])[B])]
Family 2H_B
EndFeature

# ============================================================================
# Carbon Types (sp3, sp2, sp, resonance)
# ============================================================================

# C_3 - sp3 carbon (generic)
DefineFeature @atom:C_3 [CD4]
Family 3C_3
EndFeature

# C_34 - sp3 carbon with 4 hydrogens (CH4 - methane)
DefineFeature @atom:C_34 [$([CH4])]
Family 4C_34
EndFeature

# C_33 - sp3 carbon with 3 hydrogens (CH3 - methyl)
DefineFeature @atom:C_33 [$([CH3D4])]
Family 5C_33
EndFeature

# C_32 - sp3 carbon with 2 hydrogens (CH2 - methylene)
DefineFeature @atom:C_32 [$([CH2D4])]
Family 6C_32
EndFeature

# C_31 - sp3 carbon with 1 hydrogen (CH - methine)
DefineFeature @atom:C_31 [$([CH1D4])]
Family 7C_31
EndFeature

# C_R - Aromatic/resonance carbon (in aromatic ring)
DefineFeature @atom:C_R [$([c])]
Family 8C_R
EndFeature

# C_R1 - Aromatic carbon with 1 hydrogen
DefineFeature @atom:C_R1 [$([cH1])]
Family 9C_R1
EndFeature

# C_R_b1 - Aromatic carbon in bond context 1 (fused rings)
DefineFeature @atom:C_R_b1 [$([c]([c])([c])[c])]
Family 10C_R_b1
EndFeature

# C_R1_b1 - Aromatic carbon with 1H in fused ring
DefineFeature @atom:C_R1_b1 [$([cH1]([c])([c])[c])]
Family 11C_R1_b1
EndFeature

# C_2 - sp2 carbon (double bond, not aromatic)
DefineFeature @atom:C_2 [$([CD3]=[*])]
Family 12C_2
EndFeature

# C_2_b1 - sp2 carbon in carbonyl (C=O)
DefineFeature @atom:C_2_b1 [$([CD3](=[O]))]
Family 13C_2_b1
EndFeature

# C_2_b2 - sp2 carbon double bonded to C
DefineFeature @atom:C_2_b2 [$([CD3](=[C]))]
Family 14C_2_b2
EndFeature

# C_1 - sp carbon (triple bond)
DefineFeature @atom:C_1 [$([CD2]#[*])]
Family 15C_1
EndFeature

# C_1_b1 - sp carbon in nitrile (C#N)
DefineFeature @atom:C_1_b1 [$([CD2]#[N])]
Family 16C_1_b1
EndFeature

# ============================================================================
# Nitrogen Types
# ============================================================================

# N_3 - sp3 nitrogen (amine)
DefineFeature @atom:N_3 [$([NX3;!$(N=[*]);!$(N#[*])])]
Family 17N_3
EndFeature

# N_3_hd - sp3 nitrogen as H-donor (N-H)
DefineFeature @atom:N_3_hd [$([NX3;H1,H2,H3;!$(N=[*])])]
Family 18N_3_hd
EndFeature

# N_3_ha - sp3 nitrogen as H-acceptor (lone pair)
DefineFeature @atom:N_3_ha [$([NX3;H0;!$(N=[*]);!$(N#[*])])]
Family 19N_3_ha
EndFeature

# N_R - Aromatic nitrogen
DefineFeature @atom:N_R [$([n])]
Family 20N_R
EndFeature

# N_R_d1 - Aromatic nitrogen coordination 1
DefineFeature @atom:N_R_d1 [$([nD2])]
Family 21N_R_d1
EndFeature

# N_R_d2 - Aromatic nitrogen coordination 2
DefineFeature @atom:N_R_d2 [$([nD3])]
Family 22N_R_d2
EndFeature

# N_R_d2_hd - Aromatic nitrogen coordination 2, H-donor
DefineFeature @atom:N_R_d2_hd [$([nH1])]
Family 23N_R_d2_hd
EndFeature

# N_R_b1_d2 - Aromatic nitrogen in fused ring, coordination 2
DefineFeature @atom:N_R_b1_d2 [$([n](c)(c)c)]
Family 24N_R_b1_d2
EndFeature

# N_R_b1_d2_hd - Aromatic nitrogen in fused ring, coordination 2, H-donor
DefineFeature @atom:N_R_b1_d2_hd [$([nH1](c)(c)c)]
Family 25N_R_b1_d2_hd
EndFeature

# N_R_d1_ha - Aromatic nitrogen coordination 1, H-acceptor
DefineFeature @atom:N_R_d1_ha [$([nD2;H0])]
Family 26N_R_d1_ha
EndFeature

# N_R_d2_ha - Aromatic nitrogen coordination 2, H-acceptor
DefineFeature @atom:N_R_d2_ha [$([nD3;H0])]
Family 27N_R_d2_ha
EndFeature

# N_R_b1_d2_ha - Aromatic nitrogen fused ring, coordination 2, H-acceptor
DefineFeature @atom:N_R_b1_d2_ha [$([nD3;H0](c)(c)c)]
Family 28N_R_b1_d2_ha
EndFeature

# N_2 - sp2 nitrogen (imine, C=N)
DefineFeature @atom:N_2 [$([ND2]=[*])]
Family 29N_2
EndFeature

# N_2_d1 - sp2 nitrogen coordination 1
DefineFeature @atom:N_2_d1 [$([ND2]=*)]
Family 30N_2_d1
EndFeature

# N_2_d1_hd - sp2 nitrogen coordination 1, H-donor
DefineFeature @atom:N_2_d1_hd [$([ND2;H1]=*)]
Family 31N_2_d1_hd
EndFeature

# N_2_d1_ha - sp2 nitrogen coordination 1, H-acceptor
DefineFeature @atom:N_2_d1_ha [$([ND2;H0]=*)]
Family 32N_2_d1_ha
EndFeature

# N_2_b1_d1 - sp2 nitrogen in amide (N-C=O)
DefineFeature @atom:N_2_b1_d1 [$([NX3][CX3](=[OX1]))]
Family 33N_2_b1_d1
EndFeature

# N_2_b1_d1_ha - sp2 nitrogen in amide, H-acceptor
DefineFeature @atom:N_2_b1_d1_ha [$([NX3;H0][CX3](=[OX1]))]
Family 34N_2_b1_d1_ha
EndFeature

# N_2_b2_d1 - sp2 nitrogen double bonded to C
DefineFeature @atom:N_2_b2_d1 [$([ND2]=[C])]
Family 35N_2_b2_d1
EndFeature

# N_2_b2_d1_ha - sp2 nitrogen double bonded to C, H-acceptor
DefineFeature @atom:N_2_b2_d1_ha [$([ND2;H0]=[C])]
Family 36N_2_b2_d1_ha
EndFeature

# N_2_d2 - sp2 nitrogen coordination 2
DefineFeature @atom:N_2_d2 [$([ND3]=*)]
Family 37N_2_d2
EndFeature

# N_2_d2_hd - sp2 nitrogen coordination 2, H-donor
DefineFeature @atom:N_2_d2_hd [$([ND3;H1]=*)]
Family 38N_2_d2_hd
EndFeature

# N_2_d2_ha - sp2 nitrogen coordination 2, H-acceptor
DefineFeature @atom:N_2_d2_ha [$([ND3;H0]=*)]
Family 39N_2_d2_ha
EndFeature

# N_2_b1_d2 - sp2 nitrogen in conjugated system
DefineFeature @atom:N_2_b1_d2 [$([ND3]=[*][*]=[*])]
Family 40N_2_b1_d2
EndFeature

# N_2_b1_d2_hd - sp2 nitrogen conjugated, H-donor
DefineFeature @atom:N_2_b1_d2_hd [$([ND3;H1]=[*][*]=[*])]
Family 41N_2_b1_d2_hd
EndFeature

# N_2_b1_d2_ha - sp2 nitrogen conjugated, H-acceptor
DefineFeature @atom:N_2_b1_d2_ha [$([ND3;H0]=[*][*]=[*])]
Family 42N_2_b1_d2_ha
EndFeature

# N_2_b2_d2 - sp2 nitrogen in nitro-like
DefineFeature @atom:N_2_b2_d2 [$([ND3](=[O])=[O])]
Family 43N_2_b2_d2
EndFeature

# N_2_b2_d2_hd - sp2 nitrogen nitro-like, H-donor (unusual)
DefineFeature @atom:N_2_b2_d2_hd [$([ND3;H1](=[O])=[O])]
Family 44N_2_b2_d2_hd
EndFeature

# N_2_b2_d2_ha - sp2 nitrogen nitro-like, H-acceptor
DefineFeature @atom:N_2_b2_d2_ha [$([ND3;H0](=[O])=[O])]
Family 45N_2_b2_d2_ha
EndFeature

# N_1 - sp nitrogen (nitrile N)
DefineFeature @atom:N_1 [$([ND1]#*)]
Family 46N_1
EndFeature

# N_1_ha - sp nitrogen, H-acceptor
DefineFeature @atom:N_1_ha [$([ND1]#*)]
Family 47N_1_ha
EndFeature

# ============================================================================
# Oxygen Types
# ============================================================================

# O_3 - sp3 oxygen (ether, alcohol)
DefineFeature @atom:O_3 [$([OX2;!$(O=*)])]
Family 48O_3
EndFeature

